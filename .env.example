CONCIERGE_CONTEXT_TTL_SECONDS=900
CONCIERGE_CONTEXT_MAX_TOPICS=12
# Local development profile.
CONCIERGE_ENV=development
CONCIERGE_DB_PATH=./data/concierge.sqlite3
CONCIERGE_PUBLIC_ORIGIN=http://localhost:8000
LANGGRAPH_STRICT_MSGPACK=true

CONCIERGE_DOMAIN_PROFILE_PATH=config/agent-domain.json
CONCIERGE_DOMAIN_PROFILE_SHA256=82a73ed6f1ed24b04dcfa9a507d4d7becd31f3c7c15f76e60201e98082a64635

CONCIERGE_RUNTIME_PROFILE=development

CONCIERGE_PROPERTY_PROFILE_PATH=releases/property-profile.json
CONCIERGE_PROPERTY_PROFILE_SHA256=410f1fcfe7d7a12c3d953ec145d66b2df0175d3589aeba3dd722d463892eded2
CONCIERGE_STRUCTURED_DATASET_DIR=datasets
CONCIERGE_MAP_RELEASE_PATH=releases/map-release.json
CONCIERGE_MAP_RELEASE_SHA256=c1ad091d78f8e92779d42420e561119295878cfc7bfed631b9a6b38090698c7a
CONCIERGE_PLANNING_RELEASE_PATH=releases/planning-release.json
CONCIERGE_PLANNING_RELEASE_SHA256=2c0936880c7478a031597d2fa8b46483109806fc7c0a49fba63589a0bbf829ff

# Model, feature, budget and timeout defaults come from the pinned runtime profile above.
# Optional process-level overrides (examples):
CONCIERGE_LLM_MODEL=qwen2.5:7b
# CONCIERGE_LLM_FALLBACK_MODEL=qwen2.5:1.5b
# CONCIERGE_AGENT_MAX_STEPS=12
# CONCIERGE_AGENT_PLANNER_TIMEOUT_SECONDS=7.0
# Ollama is loopback-only; the local bge-m3 model is used for multilingual dense retrieval.
CONCIERGE_EMBEDDING_MODEL_PATH=ollama://bge-m3
CONCIERGE_EMBEDDING_MANIFEST_PATH=models/embeddings/bge-m3.ollama.manifest.json
# INT4 OpenVINO bge-reranker-v2-m3, pinned by the runtime profile manifest.
CONCIERGE_RERANK_MODEL_PATH=models/reranker/bge-reranker-v2-m3-int4-ov
CONCIERGE_RERANK_MANIFEST_PATH=models/reranker/bge-reranker-v2-m3-int4-ov.manifest.json
# For an offline pinned filesystem model, replace both values with the model and manifest paths.

# Production credentials and signed runtime assets.
CONCIERGE_PRODUCTION_SIGNOFF_PATH=
CONCIERGE_PRODUCTION_SIGNOFF_SIGNATURE_PATH=
CONCIERGE_PRODUCTION_SIGNOFF_PUBLIC_KEY_PATH=
CONCIERGE_STAFF_TOKEN=
CONCIERGE_AGENT_TOKEN=
CONCIERGE_STATUS_TOKEN_SECRET=
CONCIERGE_STAFF_CREDENTIALS_JSON=
CONCIERGE_STAFF_GATEWAY_TOKEN=
CONCIERGE_ALLOWED_CLIENT_CIDRS=
CONCIERGE_STAFF_ORIGIN=

# Optional voice assets.
# Local voice models: python tools/runtime/download_voice_models.py
CONCIERGE_WHISPER_MODEL_PATH=models/voice/whisper-small
CONCIERGE_PIPER_MODELS_DIR=models/voice/piper
# Optional hotel-operations integrations. Leave unset to keep staff/manual fallback.
# CONCIERGE_ROOM_QR_SECRET=replace-with-32-byte-minimum-secret
# CONCIERGE_GUEST_VERIFY_URL=https://pms-bridge.example.internal/verify-guest
# CONCIERGE_GUEST_VERIFY_TOKEN=replace-with-secret-token
# CONCIERGE_SERVICE_DISPATCH_URL=https://hotel-ops-bridge.example.internal/requests
# CONCIERGE_SERVICE_DISPATCH_TOKEN=replace-with-secret-token
## Optional WP14 observability: explicit destination required, no raw content.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_SAMPLE_RATE=0.1
# Optional >=32-character deployment secret; blank rotates pseudonyms on restart.
LANGFUSE_PSEUDONYM_KEY=
