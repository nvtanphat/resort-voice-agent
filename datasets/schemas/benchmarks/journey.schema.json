{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multi-turn agent journey",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "journey_id",
    "classification",
    "truth_status",
    "language",
    "evaluation_bucket",
    "turns"
  ],
  "properties": {
    "journey_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "classification": {
      "enum": [
        "hospitality_journey_synthetic",
        "production_evaluation_synthetic"
      ]
    },
    "truth_status": {
      "enum": [
        "synthetic_guest_journey",
        "synthetic_simulation"
      ]
    },
    "language": {
      "enum": [
        "en",
        "vi",
        "ko",
        "zh"
      ]
    },
    "journey_family": {
      "type": "string"
    },
    "evaluation_bucket": {
      "type": "string"
    },
    "guest_archetype_id": {
      "type": "string"
    },
    "stay_phase": {
      "type": "string"
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "turn",
          "utterance",
          "assertions"
        ],
        "properties": {
          "turn": {
            "type": "integer",
            "minimum": 1
          },
          "utterance": {
            "type": "string",
            "minLength": 1
          },
          "assertions": {
            "type": "object"
          },
          "expected_route": {
            "type": "string"
          }
        }
      }
    }
  }
}
