{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Backend API behaviour case (evaluation only, never training)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "group", "turns", "repeat"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z]+-[A-Za-z0-9-]+$"},
    "group": {"enum": ["CHAT", "KB", "SVC", "NEG", "SAFE", "CMP", "EMG", "NOREQ", "DLG", "REF", "PREF", "PLAN"]},
    "repeat": {"type": "integer", "minimum": 1, "maximum": 10},
    "note": {"type": "string", "maxLength": 300},
    "turns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query", "language", "expect"],
        "properties": {
          "query": {"type": "string", "minLength": 1, "maxLength": 500},
          "language": {"enum": ["vi", "en", "zh", "ko"]},
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": {"enum": [
                "courtesy", "no_action", "knowledge", "grounded_or_abstain", "abstain", "clarify",
                "map", "map_or_abstain", "service", "asks_slot", "service_or_asks", "emergency",
                "compound", "conditional", "read_compound", "cancel_then_service", "forbid",
                "not_injection", "not_submitted", "language_switch", "cancelled", "not_cancelled",
                "no_invented_room", "no_auto_service", "read_only", "observe"
              ]},
              "service": {"oneOf": [
                {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}
              ]},
              "services": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
              "absent_services": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
              "slots": {"type": "object", "additionalProperties": {"type": "string"}},
              "fields": {"type": "array", "items": {"type": "string"}},
              "absent": {"type": "array", "items": {"type": "string"}},
              "forbid": {"type": "array", "items": {"type": "string"}},
              "mentions_any": {"type": "array", "items": {"type": "string"}},
              "target": {"enum": ["vi", "en", "zh", "ko"]},
              "min_sources": {"type": "integer", "minimum": 1},
              "max_seconds": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        }
      }
    }
  }
}
