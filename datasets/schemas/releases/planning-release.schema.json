{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved multilingual planning release",
  "type": "object",
  "additionalProperties": false,
  "required": ["approved", "property_id", "effective_from", "effective_to", "activities"],
  "properties": {
    "approved": {"const": true},
    "property_id": {"type": "string", "minLength": 1},
    "effective_from": {"type": "string", "format": "date"},
    "effective_to": {"type": "string", "format": "date"},
    "activities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/activity"}}
  },
  "$defs": {
    "localized": {
      "type": "object", "additionalProperties": false,
      "required": ["en", "vi", "ko", "zh"],
      "properties": {"en": {"type": "string", "minLength": 1}, "vi": {"type": "string", "minLength": 1}, "ko": {"type": "string", "minLength": 1}, "zh": {"type": "string", "minLength": 1}}
    },
    "activity": {
      "type": "object", "additionalProperties": false,
      "required": ["activity_id", "topic", "aliases", "source_id", "source_revisions", "source_quote", "duration_minutes", "travel_buffer_minutes", "weekdays", "windows"],
      "properties": {
        "activity_id": {"type": "string", "minLength": 1}, "topic": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source_id": {"type": "string", "minLength": 1}, "source_revisions": {"$ref": "#/$defs/localized"}, "source_quote": {"$ref": "#/$defs/localized"},
        "duration_minutes": {"type": "integer", "minimum": 1}, "travel_buffer_minutes": {"type": "integer", "minimum": 0},
        "weekdays": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 6}},
        "windows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/window"}}
      }
    },
    "window": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": {"start": {"type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"}, "end": {"type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"}}
    }
  }
}
