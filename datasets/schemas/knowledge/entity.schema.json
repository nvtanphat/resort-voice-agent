{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical entity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entity_id",
    "entity_type",
    "name",
    "names_by_locale",
    "domain",
    "source_urls",
    "description",
    "knowledge_status"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "entity_type": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "names_by_locale": {
      "type": "object",
      "required": [
        "en"
      ],
      "properties": {
        "en": {
          "type": "string"
        },
        "vi": {
          "type": "string"
        },
        "ko": {
          "type": "string"
        },
        "zh": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "source_urls": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "description": {
      "type": "string"
    },
    "knowledge_status": {
      "type": "string",
      "minLength": 1
    },
    "publication_status": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date"
    },
    "curation_reason": {
      "type": "string"
    },
    "curated_at": {
      "type": "string",
      "format": "date"
    },
    "status_reason": {
      "type": "string"
    }
  }
}
