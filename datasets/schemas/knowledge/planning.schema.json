{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:furama:knowledge:planning:v1",
  "title": "Furama canonical operating schedule and planning constraints",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "property_id",
    "operating_schedule",
    "lead_times_and_slas"
  ],
  "properties": {
    "property_id": {
      "const": "FURAMA_DANANG"
    },
    "operating_schedule": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "hours",
          "source_type",
          "provenance"
        ],
        "properties": {
          "item": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "hours": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "source_type": {
            "const": "factual"
          },
          "provenance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "lead_times_and_slas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service",
          "min_value",
          "max_value",
          "unit",
          "source_type",
          "provenance",
          "note"
        ],
        "properties": {
          "service": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "min_value": {
            "type": "number",
            "minimum": 0
          },
          "max_value": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "source_type": {
            "const": "factual"
          },
          "provenance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
