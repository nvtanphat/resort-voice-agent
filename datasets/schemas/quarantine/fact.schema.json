{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quarantined knowledge fact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canonical_fact_id",
    "property_id",
    "entity_id",
    "fact_type",
    "context",
    "raw_value",
    "normalized_value",
    "unit",
    "confidence",
    "provenance_sources",
    "locale_support",
    "publication_status",
    "archived_at"
  ],
  "properties": {
    "canonical_fact_id": {
      "type": "string",
      "pattern": "^cfact_[0-9a-f]{16,64}$"
    },
    "property_id": {
      "const": "FURAMA_DANANG"
    },
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "fact_type": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "raw_value": {
      "type": "string"
    },
    "normalized_value": {
      "type": [
        "string",
        "number",
        "integer",
        "object"
      ]
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "provenance_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "document_id",
          "source_url",
          "evidence",
          "evidence_sha256",
          "is_dedicated_page"
        ],
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "is_dedicated_page": {
            "type": "boolean"
          },
          "verified_at": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "locale_support": {
      "type": "object",
      "required": [
        "en",
        "vi",
        "ko",
        "zh"
      ],
      "properties": {
        "en": {
          "type": "string"
        },
        "vi": {
          "type": "string"
        },
        "ko": {
          "type": "string"
        },
        "zh": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "publication_status": {
      "type": "string",
      "minLength": 1
    },
    "archived_at": {
      "type": "string",
      "format": "date"
    },
    "curation_reason": {
      "type": "string"
    },
    "curated_at": {
      "type": "string",
      "format": "date"
    },
    "verified_at": {
      "type": "string",
      "format": "date"
    },
    "curation_method": {
      "type": "string"
    },
    "verification_status": {
      "type": "string"
    },
    "source_tier": {
      "type": "string"
    },
    "localization_method": {
      "type": "string"
    },
    "localization_reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "status_reason": {
      "type": "string"
    },
    "conflict_status": {
      "type": "string"
    },
    "conservative_guidance": {
      "type": "string"
    }
  }
}
