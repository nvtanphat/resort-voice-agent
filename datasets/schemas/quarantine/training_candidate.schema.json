{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quarantined training candidate (never loaded as an example)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "split",
    "language",
    "utterance",
    "expected_route",
    "commands",
    "source_family",
    "source_id",
    "gold_status",
    "training_priority",
    "frame_id",
    "concept_key",
    "quarantine_reason",
    "archived_at"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^CAND-[A-Z0-9_-]+$"
    },
    "split": {
      "const": "train"
    },
    "language": {
      "enum": [
        "vi",
        "en",
        "zh",
        "ko"
      ]
    },
    "utterance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "expected_route": {
      "enum": [
        "service",
        "knowledge",
        "navigation",
        "non_action",
        "escalation",
        "request_change",
        "status",
        "planning",
        "preference",
        "clarification",
        "language",
        "slot_reply",
        "multi_step",
        "availability",
        "emergency"
      ]
    },
    "service_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "type"
        ]
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pending_field": {
          "type": "string"
        },
        "last_verified_topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "source_family": {
      "const": "assistant_generated"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "gold_status": {
      "const": "QUARANTINED"
    },
    "training_priority": {
      "enum": [
        "primary",
        "support"
      ]
    },
    "frame_id": {
      "type": "string",
      "minLength": 1
    },
    "concept_key": {
      "type": "string",
      "minLength": 1
    },
    "quarantine_reason": {
      "type": "string",
      "minLength": 1
    },
    "archived_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
