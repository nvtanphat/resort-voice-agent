{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic guest-service workflow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "name",
    "service_id",
    "department_id",
    "channel",
    "dispatch_mode",
    "estimated_duration_min",
    "steps",
    "automation_level",
    "timing_classification",
    "timing_is_official_sla",
    "property_id",
    "truth_status",
    "data_boundary"
  ],
  "properties": {
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "service_id": {
      "type": "string",
      "minLength": 1
    },
    "department_id": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "minLength": 1
    },
    "dispatch_mode": {
      "type": "string",
      "minLength": 1
    },
    "estimated_duration_min": {
      "type": "integer",
      "minimum": 0
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "step",
          "actor",
          "action"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "automation_level": {
      "type": "string",
      "minLength": 1
    },
    "timing_classification": {
      "type": "string",
      "minLength": 1
    },
    "timing_is_official_sla": {
      "type": "boolean"
    },
    "property_id": {
      "const": "FURAMA_DANANG"
    },
    "truth_status": {
      "const": "synthetic_operational"
    },
    "data_boundary": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  }
}
