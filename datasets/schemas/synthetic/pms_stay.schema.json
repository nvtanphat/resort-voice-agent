{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic PMS stay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stay_id",
    "classification",
    "booking_ref",
    "guest_profile_id",
    "guest_name",
    "name_is_synthetic",
    "language",
    "email",
    "unit_ref",
    "status",
    "check_in_date",
    "check_out_date",
    "adults",
    "children",
    "vip_tier",
    "rate_plan",
    "preferences",
    "open_balance_vnd",
    "late_checkout_eligible_demo",
    "room_charge_enabled",
    "verification",
    "truth_status",
    "assumption_refs"
  ],
  "properties": {
    "stay_id": {
      "type": "string",
      "pattern": "^SIM-STAY-[0-9]{4}$"
    },
    "classification": {
      "const": "synthetic_simulation"
    },
    "booking_ref": {
      "type": "string",
      "pattern": "^DEMO-[0-9]{8}$"
    },
    "guest_profile_id": {
      "type": "string",
      "pattern": "^SIM-GUEST-[0-9]{4}$"
    },
    "guest_name": {
      "type": "string",
      "minLength": 2
    },
    "name_is_synthetic": {
      "const": true
    },
    "language": {
      "enum": [
        "en",
        "vi",
        "ko",
        "zh"
      ]
    },
    "email": {
      "type": "string",
      "pattern": "@demo\\.invalid$"
    },
    "unit_ref": {
      "type": "string",
      "pattern": "^SIM-(?:ROOM|VILLA)-[0-9]{4}$"
    },
    "status": {
      "enum": [
        "IN_HOUSE",
        "ARRIVING"
      ]
    },
    "check_in_date": {
      "type": "string",
      "format": "date"
    },
    "check_out_date": {
      "type": "string",
      "format": "date"
    },
    "adults": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "children": {
      "type": "integer",
      "minimum": 0,
      "maximum": 12
    },
    "vip_tier": {
      "enum": [
        "STANDARD",
        "MEMBER",
        "GOLD",
        "PLATINUM"
      ]
    },
    "rate_plan": {
      "enum": [
        "ROOM_ONLY",
        "RESORT_ESCAPE",
        "VILLA_ESCAPE",
        "FLEX_BREAKFAST"
      ]
    },
    "preferences": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "open_balance_vnd": {
      "type": "integer",
      "minimum": 0
    },
    "late_checkout_eligible_demo": {
      "type": "boolean"
    },
    "room_charge_enabled": {
      "type": "boolean"
    },
    "arrival_window": {
      "type": "string"
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "surname",
        "demo_only"
      ],
      "properties": {
        "method": {
          "enum": [
            "room_plus_surname",
            "booking_ref_plus_surname"
          ]
        },
        "surname": {
          "type": "string",
          "minLength": 1
        },
        "demo_only": {
          "const": true
        }
      }
    },
    "truth_status": {
      "const": "synthetic_simulation"
    },
    "assumption_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
