{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic engineering workflow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "classification",
    "service_code",
    "department_id",
    "issue_type",
    "severity",
    "required_slots",
    "optional_slots",
    "timing",
    "steps",
    "safety_exclusions",
    "source_refs",
    "truth_note"
  ],
  "properties": {
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "const": "synthetic_operational"
    },
    "service_code": {
      "type": "string",
      "minLength": 1
    },
    "department_id": {
      "type": "string",
      "minLength": 1
    },
    "issue_type": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "minLength": 1
    },
    "guest_examples": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "required_slots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "optional_slots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timing": {
      "type": "object",
      "minProperties": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "step",
          "actor",
          "action"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "safety_exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "truth_note": {
      "type": "string",
      "minLength": 1
    }
  }
}
