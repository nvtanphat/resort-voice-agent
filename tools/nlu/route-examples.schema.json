{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["example_id", "language", "text", "route", "split", "source", "source_scenario_id"],
  "properties": {
    "example_id": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2, "maxLength": 8},
    "text": {"type": "string", "minLength": 1, "maxLength": 1000},
    "route": {"type": "string", "minLength": 1},
    "split": {"type": "string", "enum": ["train", "validation"]},
    "source": {"const": "human_review_gold"},
    "source_scenario_id": {"type": "string", "minLength": 1},
    "surface_style": {"type": ["string", "null"]},
    "service_code": {"type": ["string", "null"]}
  }
}
