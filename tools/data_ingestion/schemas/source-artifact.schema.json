{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Furama Source Artifact Registry ",
  "type": "object",
  "required": [
    "artifact_id", "property_id", "publisher", "source_kind", "source_url",
    "verification_state", "evidence_count", "evidence_hashes"
  ],
  "properties": {
    "artifact_id": {"type": "string", "minLength": 4, "maxLength": 160},
    "property_id": {"const": "FURAMA_DANANG"},
    "publisher": {"type": "string", "minLength": 1, "maxLength": 120},
    "source_kind": {"enum": ["official_html", "official_pdf"]},
    "source_url": {"type": "string", "format": "uri"},
    "verified_at": {"type": ["string", "null"], "format": "date"},
    "verification_state": {"enum": ["verified_evidence", "unverified_evidence", "raw_archived"]},
    "evidence_count": {"type": "integer", "minimum": 1},
    "evidence_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "raw_path": {"type": ["string", "null"]},
    "raw_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "extracted_text_path": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"verification_state": {"const": "raw_archived"}}, "required": ["verification_state"]},
      "then": {
        "required": ["raw_path", "raw_sha256"],
        "properties": {
          "raw_path": {"type": "string", "minLength": 1},
          "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  ],
  "additionalProperties": false
}
