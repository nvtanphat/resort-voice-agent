{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concierge-kiosk.local/schemas/crawler-config.schema.json",
  "title": "Concierge Kiosk Hotel Crawler Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "property_id",
    "property_name",
    "property_timezone",
    "host",
    "brand_path",
    "property_slug",
    "locales",
    "seed_sections",
    "required_sections",
    "discover_sections",
    "excluded_path_tokens",
    "official_pdf_sources",
    "max_pages",
    "concurrency",
    "request_delay_seconds",
    "request_jitter_seconds",
    "max_retries",
    "browser_profile_dir",
    "timeout_seconds",
    "min_content_chars"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "property_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{2,80}$"},
    "property_name": {"type": "string", "minLength": 1, "maxLength": 120},
    "property_timezone": {"type": "string", "minLength": 1, "maxLength": 80},
    "host": {"type": "string", "minLength": 1, "maxLength": 120},
    "brand_path": {"type": "string", "maxLength": 120},
    "property_slug": {"type": "string", "maxLength": 120},
    "locales": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en-US", "vi-VN", "zh-CN", "ko-KR"],
      "properties": {
        "en-US": {"const": "en"},
        "vi-VN": {"const": "vi"},
        "zh-CN": {"const": "zh"},
        "ko-KR": {"const": "ko"}
      }
    },
    "seed_sections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "maxLength": 100}
    },
    "required_sections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "maxLength": 100}
    },
    "discover_sections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 100}
    },
    "excluded_path_tokens": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 100}
    },
    "official_pdf_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "locale", "sections"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "locale": {"enum": ["en-US", "vi-VN", "zh-CN", "ko-KR"]},
          "sections": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["overview", "hotel-info", "meetings"]}
          }
        }
      }
    },
    "max_pages": {"type": "integer", "minimum": 1, "maximum": 500},
    "concurrency": {"const": 1},
    "request_delay_seconds": {"type": "number", "minimum": 0.5, "maximum": 10},
    "request_jitter_seconds": {"type": "number", "minimum": 0, "maximum": 10},
    "max_retries": {"type": "integer", "minimum": 0, "maximum": 6},
    "browser_profile_dir": {"type": "string", "minLength": 3, "maxLength": 240},
    "timeout_seconds": {"type": "number", "minimum": 5, "maximum": 120},
    "min_content_chars": {"type": "integer", "minimum": 80, "maximum": 5000}
  }
}
