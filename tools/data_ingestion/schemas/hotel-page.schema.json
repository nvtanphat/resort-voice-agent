{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concierge-kiosk.local/schemas/hotel-page.schema.json",
  "title": "Normalized Hotel Web Page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "property_id",
    "property_name",
    "language",
    "locale",
    "document_id",
    "domain",
    "page_type",
    "source_url",
    "canonical_url",
    "title",
    "retrieved_at",
    "fetch_method",
    "http_status",
    "source_kind",
    "provenance_status",
    "needs_review",
    "synthetic_reason",
    "source_sha256",
    "content_sha256",
    "content_markdown"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "property_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "property_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "language": {
      "enum": [
        "vi",
        "en",
        "zh",
        "ko"
      ]
    },
    "locale": {
      "enum": [
        "vi-VN",
        "en-US",
        "zh-CN",
        "ko-KR"
      ]
    },
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{4,80}$"
    },
    "domain": {
      "enum": [
        "check_in_out",
        "facilities",
        "housekeeping",
        "restaurant",
        "navigation",
        "hotel_policies",
        "general"
      ]
    },
    "page_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "canonical_url": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "fetch_method": {
      "enum": [
        "http",
        "playwright",
        "pdf_http",
        "verified_seed",
        "synthetic"
      ]
    },
    "http_status": {
      "type": "integer",
      "minimum": 0,
      "maximum": 599
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_markdown": {
      "type": "string",
      "minLength": 10
    },
    "discovered_urls": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "source_kind": {
      "enum": [
        "official_property_website",
        "official_property_pdf",
        "verified_seed",
        "synthetic_fallback"
      ]
    },
    "provenance_status": {
      "enum": [
        "official",
        "derived",
        "synthetic"
      ]
    },
    "needs_review": {
      "type": "boolean"
    },
    "synthetic_reason": {
      "type": "string",
      "maxLength": 500
    }
  }
}
