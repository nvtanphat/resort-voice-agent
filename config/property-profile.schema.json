{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Concierge Kiosk Property Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "property_id",
    "property_name",
    "property_timezone",
    "default_language",
    "enabled_languages",
    "session_policy",
    "voice_policy",
    "service_catalog"
  ],
  "properties": {
    "property_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{0,63}$"
    },
    "property_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "property_timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "default_language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
    },
    "enabled_languages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
      }
    },
    "session_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idle_timeout_seconds",
        "warning_seconds"
      ],
      "properties": {
        "idle_timeout_seconds": {
          "type": "integer",
          "minimum": 30
        },
        "warning_seconds": {
          "type": "integer",
          "minimum": 5
        }
      }
    },
    "voice_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "sample_rate",
        "max_frame_bytes",
        "queue_bytes",
        "credit_bytes",
        "vad_start_ms",
        "vad_end_silence_ms",
        "barge_preview_ms",
        "barge_confirm_ms",
        "false_interruption_recovery_ms",
        "backpressure_timeout_ms"
      ],
      "properties": {
        "protocol": {
          "const": 2
        },
        "sample_rate": {
          "const": 16000
        },
        "max_frame_bytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 131072
        },
        "max_windowed_audio_bytes": {
          "type": "integer",
          "minimum": 65536,
          "maximum": 20000000
        },
        "queue_bytes": {
          "type": "integer",
          "minimum": 65536,
          "maximum": 1000000
        },
        "credit_bytes": {
          "type": "integer",
          "minimum": 16384,
          "maximum": 262144
        },
        "vad_start_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 600
        },
        "vad_end_silence_ms": {
          "type": "integer",
          "minimum": 400,
          "maximum": 1800
        },
        "barge_preview_ms": {
          "type": "integer",
          "minimum": 80,
          "maximum": 400
        },
        "barge_confirm_ms": {
          "type": "integer",
          "minimum": 250,
          "maximum": 1200
        },
        "false_interruption_recovery_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 2000
        },
        "backpressure_timeout_ms": {
          "type": "integer",
          "minimum": 500,
          "maximum": 10000
        },
        "vad": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "engine": {"type": "string", "enum": ["energy", "silero_v5"]},
            "noise_floor_initial": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "positive_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "negative_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "redemption_ms": {"type": "integer", "minimum": 20, "maximum": 2000},
            "pre_speech_pad_ms": {"type": "integer", "minimum": 0, "maximum": 2000},
            "min_speech_ms": {"type": "integer", "minimum": 40, "maximum": 2000},
            "playback_positive_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "continuation_extra_ms": {"type": "integer", "minimum": 0, "maximum": 3000}
          }
        }
      }
    },
    "service_catalog": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "request_kind",
          "title",
          "question"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          },
          "request_kind": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          },
          "title": {
            "$ref": "#/$defs/translations"
          },
          "question": {
            "$ref": "#/$defs/translations"
          }
        }
      }
    },
    "low_risk_requires_verified_room": {
      "type": "boolean",
      "default": false
    },
    "emergency_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "escalation_after_seconds",
        "default_kiosk_location"
      ],
      "properties": {
        "escalation_after_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 86400
        },
        "default_kiosk_location": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        }
      }
    }
  },
  "$defs": {
    "translations": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    }
  }
}
