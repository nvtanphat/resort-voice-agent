{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concierge-kiosk.local/schemas/domain-vocab.json",
  "title": "Property domain vocabulary release",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "property_id", "languages", "source_files", "entities", "services", "categories"],
  "properties": {
    "schema_version": {"const": 1},
    "property_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "source_files": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "entities": {"type": "array", "items": {"$ref": "#/$defs/vocab_item"}},
    "services": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "code", "entity_id", "category", "department", "request_kind", "names", "aliases"],
        "properties": {
          "id": {"type": "string"}, "code": {"type": "string"},
          "entity_id": {"type": "string"}, "category": {"type": "string"},
          "department": {"type": ["string", "null"]},
          "request_kind": {"type": "string", "minLength": 1},
          "names": {"$ref": "#/$defs/localized_terms"},
          "aliases": {"$ref": "#/$defs/localized_terms"}
        }
      }
    },
    "categories": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}}
  },
  "$defs": {
    "localized_terms": {
      "type": "object",
      "additionalProperties": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
    },
    "vocab_item": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "category", "names", "aliases"],
      "properties": {
        "id": {"type": "string"}, "category": {"type": "string"},
        "names": {"$ref": "#/$defs/localized_terms"},
        "aliases": {"$ref": "#/$defs/localized_terms"}
      }
    }
  }
}
