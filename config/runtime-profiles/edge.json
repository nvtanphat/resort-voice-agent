{
  "schema_version": 1,
  "profile_id": "edge",
  "models": {
    "slm": {
      "base_url": "http://127.0.0.1:11434",
      "primary_model": "qwen2.5:1.5b",
      "fallback_model": "",
      "num_gpu": 0,
      "digest": "",
      "strict_mode": false
    },
    "embedding": {
      "selection": "first_available",
      "candidates": [
        {
          "model_path": "ollama://bge-m3",
          "manifest_path": "./models/embeddings/bge-m3.ollama.manifest.json"
        },
        {
          "model_path": "./models/embeddings/hash-multilingual",
          "manifest_path": "./models/embeddings/hash-multilingual.manifest.json"
        }
      ]
    },
    "reranker": {
      "model_path": "",
      "manifest_path": ""
    },
    "nli": {
      "model_path": "",
      "manifest_path": "",
      "require_manifest": false,
      "min_confidence": 0.85,
      "semantic_verifier_model": ""
    },
    "voice": {
      "whisper_model_path": "",
      "stt_models": {
        "default": {
          "model_path": "models/voice/whisper-small",
          "manifest_path": "models/voice/whisper-small.manifest.json"
        }
      },
      "stt_hallucination_phrases": [
        "thank you",
        "thanks for watching",
        "cảm ơn các bạn đã theo dõi",
        "cảm ơn các bạn đã xem",
        "ありがとうございました",
        "시청해 주셔서 감사합니다"
      ],
      "piper_models_dir": "",
      "piper_executable": "piper",
      "tts": {
        "default": {
          "engine": "piper",
          "model": "",
          "manifest_path": "models/voice/piper/piper.manifest.json"
        }
      },
      "incremental_model_path": "",
      "incremental_language": "en",
      "incremental_manifest_path": "",
      "incremental_require_manifest": false,
      "final_manifest_path": "",
      "final_require_manifest": false
    }
  },
  "features": {
    "semantic_generation": true,
    "semantic_require_independent_nli": false,
    "agent_planner": true,
    "semantic_understanding": true,
    "voice_windowed_preview": false,
    "voice_preview_stability": false,
    "voice_incremental": false,
    "voice_transport": "legacy"
  },
  "budgets": {
    "agent": {
      "max_steps": 10,
      "max_wall_time_ms": 15000,
      "max_planner_calls": 6,
      "max_read_calls": 6
    },
    "rag": {
      "vector_path": "data/vectors",
      "min_dense_similarity": 0.65,
      "lexical_coverage": 0.6,
      "rrf_k": 60,
      "dense_max_rows": 5000,
      "dense_budget_ms": 750,
      "rerank_budget_ms": 1500,
      "rerank_top_k": 4,
      "rerank_max_length": 64,
      "rerank_input": "context_text",
      "rerank_fusion_alpha": 0.3,
      "rerank_metadata_bonus": 0.2,
      "rerank_on_failure": "keep_rrf"
    },
    "voice": {
      "max_previews": 2,
      "max_audio_seconds": 25.0,
      "max_audio_bytes": 6000000,
      "speech_plan": {
        "max_chars": 750,
        "first_chunk_max_chars": 120,
        "clause_split_min_chars": 220
      },
      "language_switch_min_probability": 0.8,
      "slm_caps": {
        "reference": 0.8,
        "planner": 1.5,
        "goal": 1.0,
        "intent": 1.5,
        "generation": 1.5
      },
      "stt_threads_max": 8,
      "stt_prompt_labels": 8,
      "stt_prompt_languages": [
        "vi",
        "ko",
        "zh"
      ],
      "stt_short_audio_seconds": 1.5,
      "stt_short_audio_temperature": 0.0,
      "ws_idle_timeout_seconds": 5,
      "voice_vad_stop_secs": 0.65,
      "voice_user_turn_stop_timeout_seconds": 2.0
    },
    "slm": {
      "circuit_cooldown_seconds": 15
    }
  },
  "timeouts": {
    "agent_planner_seconds": 5.0,
    "stt_seconds": 30.0,
    "tts_seconds": 20.0,
    "goal_interpreter_seconds": 2.5,
    "reference_resolver_seconds": 1.8,
    "intent_parser_seconds": 10.0,
    "text_generation_seconds": 5.0,
    "slm_generation_seconds": 6.0,
    "slm_probe_seconds": 1.5
  }
}
